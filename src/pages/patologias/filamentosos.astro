---
// src/pages/patologias/filamentosos.astro
// Patologías por Hongos Filamentosos — with TableOfContents (toc: true)
// Source: 02-RESEARCH.md Pattern 2 (Astro 7 Content Rendering), Pattern 7 (TOC)
// tocItems IDs verified against Sätteri-generated slugs
import { getEntry, render } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';

const entry = await getEntry('patologias', 'filamentosos');
if (!entry) throw new Error('Entry not found: patologias/filamentosos');

const { Content } = await render(entry);

// IDs are Sätteri auto-generated kebab-case slugs from h2 text
// "Dermatofitosis" → "dermatofitosis"
// "Aspergilosis" → "aspergilosis"
const tocItems = [
  { id: 'dermatofitosis', label: 'Dermatofitosis' },
  { id: 'aspergilosis', label: 'Aspergilosis' },
];
---
<ContentPage
  title={entry.data.title}
  description={entry.data.description}
  toc={true}
  tocItems={tocItems}
  lang={entry.data.lang}
>
  <Content />
</ContentPage>
