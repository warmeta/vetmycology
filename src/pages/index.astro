---
// src/pages/index.astro — Home page (Phase 2 Wave 1 placeholder)
// Full home content (hero, logos, Dr. Begoña, 3 photos) is Plan 03 Task 1.
// This version provides BaseLayout shell for header/footer Wave 1 verification.
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = 'Grupo de Micología Veterinaria · ULPGC';
---

<BaseLayout title={pageTitle} description="Sitio web del Grupo de Micología Veterinaria de la ULPGC, Facultad de Veterinaria.">
  <main id="main-content" style="max-width: 740px; margin: 0 auto; padding: var(--space-xl) var(--space-lg);">
    <h1>Grupo de Micología Veterinaria</h1>
    <p>Página en construcción. El contenido completo estará disponible en breve.</p>
    <p lang="es">Micología Veterinaria — ñoño, cándida, pérez</p>
  </main>
</BaseLayout>
