---
import { getEntry, render } from 'astro:content';
import ContentPage from '../../../layouts/ContentPage.astro';

const entry = await getEntry('patologias-en', 'micosis-peces');
if (!entry) throw new Error('Entry not found: patologias-en/micosis-peces');
const { Content } = await render(entry);
---
<ContentPage title={entry.data.title} description={entry.data.description} lang={entry.data.lang}
  breadcrumbParent={entry.data.breadcrumb_parent}>
  <Content />
</ContentPage>
