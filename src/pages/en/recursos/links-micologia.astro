---
import { getEntry, render } from 'astro:content';
import ContentPage from '../../../layouts/ContentPage.astro';

const entry = await getEntry('recursos-en', 'links-micologia');
if (!entry) throw new Error('Entry not found: recursos-en/links-micologia');
const { Content } = await render(entry);
---
<ContentPage title={entry.data.title} description={entry.data.description} lang={entry.data.lang}>
  <Content />
</ContentPage>
