---
import { getEntry, render } from 'astro:content';
import ContentPage from '../../../layouts/ContentPage.astro';

const entry = await getEntry('investigacion-en', 'articulos-interesantes');
if (!entry) throw new Error('Entry not found: investigacion-en/articulos-interesantes');
const { Content } = await render(entry);
---
<ContentPage title={entry.data.title} description={entry.data.description} lang={entry.data.lang}>
  <Content />
</ContentPage>
