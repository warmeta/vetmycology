---
import { getEntry, render } from 'astro:content';
import ContentPage from '../../../layouts/ContentPage.astro';

const entry = await getEntry('laboratorio-en', 'laboratorio');
if (!entry) throw new Error('Entry not found: laboratorio-en/laboratorio');
const { Content } = await render(entry);
---
<ContentPage title={entry.data.title} description={entry.data.description} lang={entry.data.lang}>
  <Content />
</ContentPage>
