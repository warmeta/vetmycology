---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Error del servidor" lang="es">
  <main id="main-content" tabindex="-1" style="max-width:740px;margin:0 auto;padding:var(--space-3xl) var(--space-lg);text-align:center;">
    <h1 style="font-family:var(--font-heading);font-size:var(--font-size-h1);margin-bottom:var(--space-lg);">Error del servidor</h1>
    <p style="font-family:var(--font-body);font-size:var(--font-size-body);color:var(--color-text);">
      No ha sido posible cargar el contenido. Por favor, inténtelo de nuevo en unos minutos.
    </p>
    <p style="margin-top:var(--space-xl);">
      <a href="/" style="color:var(--color-accent);">Volver a inicio</a>
    </p>
  </main>
</BaseLayout>
