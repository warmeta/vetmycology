---
import { getEntry, render } from 'astro:content';
import ContentPage from '../../layouts/ContentPage.astro';

const entry = await getEntry('micologia', 'grupo-de-trabajo');
if (!entry) throw new Error('Entry not found: micologia/grupo-de-trabajo');
const { Content } = await render(entry);
---
<ContentPage title={entry.data.title} description={entry.data.description} lang={entry.data.lang}>
  <Content />
</ContentPage>
