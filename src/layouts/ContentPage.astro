---
// src/layouts/ContentPage.astro
// 740px prose column wrapper around BaseLayout; renders TableOfContents when toc=true.
// Source: 02-UI-SPEC.md ContentPage Layout Contract + RESEARCH.md Pitfall 3 (:global() for prose)
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  toc?: boolean;
  tocItems?: Array<{ id: string; label: string }>;
  lang?: 'es' | 'en';
  breadcrumbParent?: string;
}

const { title, description, toc = false, tocItems = [], lang = 'es', breadcrumbParent } = Astro.props;
const t = useTranslations(lang);

// Build BreadcrumbList JSON-LD here so it can be injected into <head> via slot forwarding.
// (Astro does not propagate slot="head" from grandchild components — must be done at layout level.)
type ParentEntry = { esPath: string; enPath: string; label: Record<string, string> };
const parentMap: Record<string, ParentEntry> = {
  'Micología':    { esPath: '/micologia/generalidades/',          enPath: '/en/micologia/generalidades/',          label: { es: 'Micología',    en: 'Mycology'    } },
  'Patologías':   { esPath: '/patologias/levaduras/',             enPath: '/en/patologias/levaduras/',             label: { es: 'Patologías',   en: 'Pathologies' } },
  'Investigación':{ esPath: '/investigacion/articulos-congresos/',enPath: '/en/investigacion/articulos-congresos/',label: { es: 'Investigación',en: 'Research'    } },
  'Laboratorio':  { esPath: '/laboratorio/',                      enPath: '/en/laboratorio/',                      label: { es: 'Laboratorio', en: 'Laboratory'  } },
  'Recursos':     { esPath: '/recursos/archivo-imagenes/',        enPath: '/en/recursos/archivo-imagenes/',        label: { es: 'Recursos',     en: 'Resources'   } },
};
const siteOrigin = Astro.site?.origin ?? 'https://micologiaveterinaria.ulpgc.es';
const homeHref = lang === 'en' ? '/en/' : '/';
const homeLabel = t('breadcrumb.home');
let breadcrumbJsonLd: string | null = null;
if (breadcrumbParent) {
  const parent = parentMap[breadcrumbParent];
  const parentHref = lang === 'en' ? parent?.enPath : parent?.esPath;
  const parentLabel = parent?.label[lang] ?? breadcrumbParent;
  breadcrumbJsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': homeLabel,    'item': `${siteOrigin}${homeHref}`    },
      { '@type': 'ListItem', 'position': 2, 'name': parentLabel,  'item': `${siteOrigin}${parentHref}`  },
      { '@type': 'ListItem', 'position': 3, 'name': title },
    ],
  });
}
---
<BaseLayout title={title} description={description} lang={lang}>
  <slot name="head" slot="head" />
  {breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd} slot="head" />}
  <main id="main-content" tabindex="-1">
    <article class="content-page">
      {breadcrumbParent && <Breadcrumb breadcrumbParent={breadcrumbParent} title={title} lang={lang} />}
      <h1>{title}</h1>
      {toc && tocItems.length > 0 && <TableOfContents items={tocItems} lang={lang} />}
      <slot />
    </article>
  </main>
</BaseLayout>

<style>
  .content-page {
    max-width: 740px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg);
  }

  /* Mobile: reduce vertical padding */
  @media (max-width: 767px) {
    .content-page {
      padding: var(--space-xl) var(--space-md);
    }
  }

  /* Prose styles — MUST use :global() to reach markdown-rendered children (Pitfall 3) */
  /* Markdown-rendered HTML is outside Astro's component scope and won't receive scoped attrs */

  .content-page :global(h1) {
    font-family: var(--font-heading);
    font-size: var(--font-size-h1);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }

  .content-page :global(h2) {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }

  .content-page :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .content-page :global(p) {
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .content-page :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .content-page :global(a:visited) {
    color: #3d8a68;
  }

  .content-page :global(ul),
  .content-page :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-xl);
  }

  .content-page :global(li) {
    margin-bottom: var(--space-sm);
  }
</style>
