---
// src/components/MobileNav.astro
// Full-screen overlay nav with hidden checkbox + <details>/<summary> accordions (no JavaScript).
// navItems is fetched from Directus in BaseLayout and passed down.
// Falls back to the hardcoded DEFAULT_NAV when Directus has no items.
import { useTranslations } from '../i18n/ui';
import type { ProcessedNavItem } from '../lib/directus';
import { DEFAULT_NAV } from '../lib/defaultNav';

interface Props {
  lang?: 'es' | 'en';
  navItems?: ProcessedNavItem[];
}

const { lang = 'es', navItems } = Astro.props;
const t = useTranslations(lang);
const items: ProcessedNavItem[] = navItems?.length ? navItems : DEFAULT_NAV[lang];
---

<input type="checkbox" id="nav-toggle" class="nav-toggle-input" />

<label for="nav-toggle" class="nav-hamburger" aria-label={t('nav.hamburger.open')}>
  ☰
</label>

<div class="mobile-nav-overlay">
  <label for="nav-toggle" class="nav-close" aria-label={t('nav.hamburger.close')}>
    ✕
  </label>
  <nav>
    {items.map(group => (
      group.children?.length ? (
        <details>
          <summary>{group.label}</summary>
          <ul>
            {group.children.map(child => (
              <li><a href={child.href}>{child.label}</a></li>
            ))}
          </ul>
        </details>
      ) : (
        <a href={group.href}>{group.label}</a>
      )
    ))}
  </nav>
</div>

<style>
  .nav-toggle-input {
    display: none;
  }

  .nav-hamburger {
    display: none;
    cursor: pointer;
    color: var(--color-nav-text);
    font-size: 1.5rem;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
  }

  .mobile-nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--color-nav-bg);
    z-index: 300;
    flex-direction: column;
    padding: var(--space-lg);
    color: var(--color-nav-text);
    overflow-y: auto;
  }

  #nav-toggle:checked ~ .mobile-nav-overlay {
    display: flex;
  }

  .nav-close {
    align-self: flex-end;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--color-nav-text);
    margin-bottom: var(--space-md);
  }

  .mobile-nav-overlay nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mobile-nav-overlay a {
    color: var(--color-nav-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    padding: var(--space-sm) 0;
    min-height: 44px;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
  }

  .mobile-nav-overlay details {
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .mobile-nav-overlay summary {
    color: var(--color-nav-text);
    padding: var(--space-sm) 0;
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
  }

  .mobile-nav-overlay ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-md);
  }

  .mobile-nav-overlay ul li a {
    font-size: var(--font-size-sm);
    min-height: 44px;
  }

  @media (min-width: 1024px) {
    .nav-hamburger {
      display: none !important;
    }
    .mobile-nav-overlay {
      display: none !important;
    }
  }

  @media (max-width: 1023px) {
    .nav-hamburger {
      display: flex;
    }
  }
</style>
