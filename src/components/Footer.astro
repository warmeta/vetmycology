---
// src/components/Footer.astro
// ULPGC + IUSA logos, faculty name, affiliation text, mailto contact link.
// Source: 02-UI-SPEC.md Footer Contract (NAV-05)
// Note: Logo image files (ulpgc.png, iusa.png) must be copied from ~/Downloads/backup/
//       (LOGO.jpg → ulpgc.png, iusalogodoctorado2012.jpg → iusa.png) — Plan 05 Task 1.
//       In Phase 2 Wave 1 the images may 404; alt text degrades gracefully.
// Phase 3: added lang prop and useTranslations for affiliation and contact label.
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-logos">
      <img src="/images/logos/ulpgc.jpg" alt="Universidad de Las Palmas de Gran Canaria" />
      <img src="/images/logos/iusa.jpg" alt="Instituto Universitario de Sanidad Animal y Seguridad Alimentaria" />
    </div>
    <p class="footer-affiliation">{t('footer.affiliation')}</p>
    <p class="footer-contact">
      <a href="mailto:begona.acosta@ulpgc.es">{t('footer.contact')}: begona.acosta@ulpgc.es</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border);
    padding: var(--space-xl) var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .footer-inner {
    max-width: 740px;
    margin: 0 auto;
    text-align: center;
  }

  .footer-logos {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
  }

  .footer-logos img {
    max-height: 60px;
    width: auto;
  }

  .footer-affiliation {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    margin: var(--space-sm) 0;
  }

  .footer-contact a {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-family: var(--font-body);
  }
</style>
