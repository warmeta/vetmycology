---
// src/components/TableOfContents.astro
// <nav aria-label="En esta página"> bordered box, renders ol of anchor links from items prop.
// Source: 02-UI-SPEC.md TableOfContents Component Contract
interface Props {
  items: Array<{ id: string; label: string }>;
}

const { items } = Astro.props;
---
<nav aria-label="En esta página" class="toc">
  <p class="toc-title">En esta página</p>
  <ol>
    {items.map(item => (
      <li>
        <a href={`#${item.id}`}>{item.label}</a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .toc {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
    max-width: 480px;
  }

  .toc-title {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .toc ol {
    margin: 0;
    padding-left: var(--space-md);
    list-style: decimal;
  }

  .toc li {
    margin-bottom: var(--space-xs);
  }

  .toc a {
    color: var(--color-accent);
    text-decoration: none;
    font-size: var(--font-size-sm);
    line-height: 1.4;
  }

  .toc a:hover {
    text-decoration: underline;
  }
</style>
