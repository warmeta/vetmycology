---
// src/components/Header.astro
// Sticky header with logo-left/nav-right (desktop), logo+hamburger (mobile), skip link.
// Source: 02-UI-SPEC.md Header + Navigation Contract (D-09) + Copywriting Contract
// Phase 3: added lang prop, useTranslations, LangSwitcher, locale-aware wordmark href.
import TopNav from './TopNav.astro';
import MobileNav from './MobileNav.astro';
import LangSwitcher from './LangSwitcher.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<!-- Skip link — first child; visually hidden until focused (WCAG 2.4.1) -->
<a href="#main-content" class="skip-link">{t('skip.link')}</a>

<header class="site-header">
  <div class="header-inner">
    <a href={lang === 'en' ? '/en/' : '/'} class="site-wordmark">Grupo de Micología Veterinaria · ULPGC</a>
    <div class="header-right">
      <TopNav lang={lang} />
      <MobileNav lang={lang} />
      <LangSwitcher />
    </div>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .skip-link:focus {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    background: var(--color-accent);
    color: #000;
    padding: var(--space-sm) var(--space-md);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    z-index: 999;
  }

  .site-header {
    background: var(--color-nav-bg);
    color: var(--color-nav-text);
    position: sticky;
    top: 0;
    z-index: 100;
    height: 56px;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    padding: 0 var(--space-lg);
    max-width: 1280px;
    margin: 0 auto;
  }

  .site-wordmark {
    color: var(--color-nav-text);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60%;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .lang-switcher {
    color: var(--color-nav-text);
    font-size: var(--font-size-sm);
    font-family: var(--font-body);
  }
</style>
