---
// src/components/TopNav.astro
// 6-cluster desktop nav with CSS :hover + :focus-within dropdowns (no JavaScript).
// navItems is fetched from Directus in BaseLayout and passed down.
// Falls back to the hardcoded DEFAULT_NAV when Directus has no items.
import { useTranslations } from '../i18n/ui';
import type { ProcessedNavItem } from '../lib/directus';
import { DEFAULT_NAV } from '../lib/defaultNav';

interface Props {
  lang?: 'es' | 'en';
  navItems?: ProcessedNavItem[];
}

const { lang = 'es', navItems } = Astro.props;
const t = useTranslations(lang);
const items: ProcessedNavItem[] = navItems?.length ? navItems : DEFAULT_NAV[lang];
---
<nav class="top-nav" aria-label={t('nav.label')}>
  <ul>
    {items.map(group => (
      <li class="nav-group">
        {group.children?.length ? (
          <>
            <button type="button" class="nav-group-label" aria-haspopup="true">
              {group.label} <span aria-hidden="true" class="dropdown-arrow">▾</span>
            </button>
            <ul class="nav-dropdown">
              {group.children.map(child => (
                <li>
                  <a href={child.href}>{child.label}</a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <a class="nav-group-label" href={group.href}>{group.label}</a>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .top-nav > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    height: 96px;
  }

  .nav-group {
    position: relative;
  }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-nav-bg);
    min-width: 220px;
    z-index: 200;
    border-top: 2px solid var(--color-accent);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    display: block;
  }

  .nav-group-label {
    color: var(--color-nav-text);
    padding: 0 var(--space-md);
    height: 96px;
    display: flex;
    align-items: center;
    border-left: 4px solid transparent;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    white-space: nowrap;
  }

  a.nav-group-label {
    cursor: pointer;
  }

  button.nav-group-label {
    background: none;
    border-top: none;
    border-right: none;
    border-bottom: none;
    cursor: default;
  }

  .dropdown-arrow {
    font-size: 0.75em;
    margin-left: var(--space-xs);
    opacity: 0.75;
  }

  .nav-group:hover .nav-group-label,
  .nav-group:focus-within .nav-group-label {
    border-left-color: var(--color-accent);
  }

  .nav-dropdown a {
    color: var(--color-nav-text);
    padding: var(--space-sm) var(--space-md);
    display: block;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    white-space: nowrap;
  }

  .nav-dropdown a:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1023px) {
    .top-nav {
      display: none;
    }
  }
</style>
