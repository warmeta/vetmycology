---
// src/components/TopNav.astro
// 6-cluster desktop nav with CSS :hover + :focus-within dropdowns (no JavaScript).
// Source: 02-UI-SPEC.md Header + Navigation Contract (D-06, D-07) + RESEARCH.md Pattern 4
// Phase 3: added lang prop, useTranslations, and locale-aware hrefs via getRelativeLocaleUrl.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/ui';

interface NavChild {
  label: string;
  href: string;
}

interface NavGroup {
  label: string;
  href?: string;
  children?: NavChild[];
}

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const r = (path: string) => getRelativeLocaleUrl(lang, path);

const navGroups: NavGroup[] = [
  {
    label: t('nav.inicio'),
    href: r(''),
  },
  {
    label: t('nav.micologia'),
    children: [
      { label: t('nav.generalidades'), href: r('micologia/generalidades/') },
      { label: t('nav.grupo'), href: r('micologia/grupo-de-trabajo/') },
      { label: t('nav.colreptiles'), href: r('micologia/colreptiles/') },
    ],
  },
  {
    label: t('nav.patologias'),
    children: [
      { label: t('nav.levaduras'), href: r('patologias/levaduras/') },
      { label: t('nav.filamentosos'), href: r('patologias/filamentosos/') },
      { label: t('nav.dimorficos'), href: r('patologias/dimorficos/') },
      { label: t('nav.micosis-peces'), href: r('patologias/micosis-peces/') },
    ],
  },
  {
    label: t('nav.investigacion'),
    children: [
      { label: t('nav.articulos-congresos'), href: r('investigacion/articulos-congresos/') },
      { label: t('nav.articulos-interesantes'), href: r('investigacion/articulos-interesantes/') },
    ],
  },
  {
    label: t('nav.laboratorio'),
    href: r('laboratorio/'),
  },
  {
    label: t('nav.recursos'),
    children: [
      { label: t('nav.archivo-imagenes'), href: r('recursos/archivo-imagenes/') },
      { label: t('nav.links-micologia'), href: r('recursos/links-micologia/') },
      { label: t('nav.links-revistas'), href: r('recursos/links-revistas/') },
      { label: t('nav.bibliografia'), href: r('recursos/bibliografia/') },
    ],
  },
];
---
<nav class="top-nav" aria-label={t('nav.label')}>
  <ul>
    {navGroups.map(group => (
      <li class="nav-group">
        {group.children ? (
          <>
            <a class="nav-group-label" href={group.children[0].href}>{group.label}</a>
            <ul class="nav-dropdown">
              {group.children.map(child => (
                <li>
                  <a href={child.href}>{child.label}</a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <a class="nav-group-label" href={group.href}>{group.label}</a>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .top-nav > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    height: 56px;
  }

  .nav-group {
    position: relative;
  }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-nav-bg);
    min-width: 220px;
    z-index: 200;
    border-top: 2px solid var(--color-accent);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Keyboard accessible: :focus-within catches Tab into dropdown links */
  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    display: block;
  }

  .nav-group-label {
    color: var(--color-nav-text);
    padding: 0 var(--space-md);
    height: 56px;
    display: flex;
    align-items: center;
    border-left: 4px solid transparent;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    white-space: nowrap;
  }

  .nav-group:hover .nav-group-label,
  .nav-group:focus-within .nav-group-label {
    border-left-color: var(--color-accent);
  }

  .nav-dropdown a {
    color: var(--color-nav-text);
    padding: var(--space-sm) var(--space-md);
    display: block;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    white-space: nowrap;
  }

  .nav-dropdown a:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Hide on mobile — MobileNav handles mobile viewport */
  @media (max-width: 1023px) {
    .top-nav {
      display: none;
    }
  }
</style>
